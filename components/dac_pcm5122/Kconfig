if DAC_PCM5122

    config PCM5122_I2C_ADDR
        hex "PCM5122 I2C address"
        default 0x4D
        range 0x4C 0x4F
        help
            7-bit I2C address of the PCM5122, set by its ADR1/ADR0 strap
            pins. 0x4C and 0x4D are the two values seen on Sonocotta boards
            across hardware revisions.

    config PCM5122_MAX_VOLUME
        int "Maximum DAC volume (dB)"
        range -103 24
        default 0
        help
            Maximum volume level in dB that corresponds to AirPlay volume
            0 dB. The PCM5122 DVOL register range is +24 dB to -103 dB.
            A value of 0 means AirPlay full volume maps to 0 dB on the DAC.

    config PCM5122_ANALOG_GAIN_MINUS_6DB
        bool "Use -6 dB analog gain (1V RMS output)"
        default n
        help
            The PCM5122's analog output stage can run at 0 dB (2V RMS,
            the chip's default) or -6 dB (1V RMS). Enable this to match a
            board designed around the lower, 1V RMS output level.

endif # DAC_PCM5122
